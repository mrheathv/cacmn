generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  role          String    @default("STAFF") // ADMIN | PM | STAFF
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  projects      Project[]     @relation("ProjectManager")
  fieldReports  FieldReport[]
  notes         Note[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Clients ─────────────────────────────────────────────────────────────────

model Client {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("COMMERCIAL") // COMMERCIAL | HOA | RESIDENTIAL | OTHER
  contactName String?
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String   @default("MN")
  zip         String?
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects   Project[]
  workOrders WorkOrder[]
  estimates  Estimate[]
  invoices   Invoice[]
}

// ─── Projects ─────────────────────────────────────────────────────────────────

model Project {
  id          String    @id @default(cuid())
  name        String
  number      String    @unique
  status      String    @default("BIDDING") // BIDDING | ACTIVE | ON_HOLD | COMPLETED | CANCELLED
  type        String    @default("COMMERCIAL") // COMMERCIAL | HOA | SPECIAL
  description String?
  address     String?
  city        String?
  startDate   DateTime?
  endDate     DateTime?
  budget      Float?
  spent       Float     @default(0)
  clientId    String
  managerId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  client       Client        @relation(fields: [clientId], references: [id])
  manager      User?         @relation("ProjectManager", fields: [managerId], references: [id])
  milestones   Milestone[]
  workOrders   WorkOrder[]
  estimates    Estimate[]
  invoices     Invoice[]
  fieldReports FieldReport[]
  notes        Note[]
  lineItems    LineItem[]
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  status      String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | DELAYED
  order       Int       @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ─── Work Orders ──────────────────────────────────────────────────────────────

model WorkOrder {
  id           String    @id @default(cuid())
  number       String    @unique
  title        String
  description  String?
  status       String    @default("OPEN") // OPEN | IN_PROGRESS | COMPLETED | CANCELLED
  priority     String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  clientId     String
  projectId    String?
  scheduledAt  DateTime?
  completedAt  DateTime?
  laborCost    Float     @default(0)
  materialCost Float     @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  client  Client   @relation(fields: [clientId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])
  notes   Note[]
}

// ─── Estimates ────────────────────────────────────────────────────────────────

model Estimate {
  id         String    @id @default(cuid())
  number     String    @unique
  title      String
  status     String    @default("DRAFT") // DRAFT | SENT | APPROVED | REJECTED | REVISED
  clientId   String
  projectId  String?
  validUntil DateTime?
  notes      String?
  subtotal   Float     @default(0)
  taxRate    Float     @default(0)
  total      Float     @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  client    Client         @relation(fields: [clientId], references: [id])
  project   Project?       @relation(fields: [projectId], references: [id])
  lineItems EstimateItem[]
}

model EstimateItem {
  id          String @id @default(cuid())
  estimateId  String
  description String
  category    String @default("LABOR") // LABOR | MATERIAL | SUBCONTRACTOR | OTHER
  quantity    Float  @default(1)
  unit        String @default("hrs")
  unitPrice   Float  @default(0)
  total       Float  @default(0)
  order       Int    @default(0)

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
}

// ─── Invoices ─────────────────────────────────────────────────────────────────

model Invoice {
  id         String    @id @default(cuid())
  number     String    @unique
  status     String    @default("DRAFT") // DRAFT | SENT | PARTIAL | PAID | OVERDUE | VOID
  clientId   String
  projectId  String?
  issueDate  DateTime  @default(now())
  dueDate    DateTime?
  paidDate   DateTime?
  subtotal   Float     @default(0)
  taxRate    Float     @default(0)
  taxAmount  Float     @default(0)
  total      Float     @default(0)
  amountPaid Float     @default(0)
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  client    Client        @relation(fields: [clientId], references: [id])
  project   Project?      @relation(fields: [projectId], references: [id])
  lineItems InvoiceItem[]
}

model InvoiceItem {
  id          String @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float  @default(1)
  unitPrice   Float  @default(0)
  total       Float  @default(0)
  order       Int    @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

// ─── Line Items (Project Budget Tracking) ────────────────────────────────────

model LineItem {
  id          String @id @default(cuid())
  projectId   String
  description String
  category    String @default("LABOR")
  budgeted    Float  @default(0)
  actual      Float  @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ─── Field Reports ────────────────────────────────────────────────────────────

model FieldReport {
  id            String   @id @default(cuid())
  projectId     String
  authorId      String
  date          DateTime @default(now())
  weather       String?
  crewCount     Int      @default(0)
  hoursWorked   Float    @default(0)
  workPerformed String?
  issues        String?
  safetyNotes   String?
  createdAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
  author  User    @relation(fields: [authorId], references: [id])
}

// ─── Notes ────────────────────────────────────────────────────────────────────

model Note {
  id          String   @id @default(cuid())
  content     String
  authorId    String
  projectId   String?
  workOrderId String?
  createdAt   DateTime @default(now())

  author    User       @relation(fields: [authorId], references: [id])
  project   Project?   @relation(fields: [projectId], references: [id])
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id])
}
